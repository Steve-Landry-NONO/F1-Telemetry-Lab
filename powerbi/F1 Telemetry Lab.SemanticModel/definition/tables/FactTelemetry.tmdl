table 'FactTelemetry'

	column 'LapId'
		dataType: int64
		sourceColumn: LapId
		summarizeBy: none

	column 'Bin'
		dataType: int64
		sourceColumn: Bin
		summarizeBy: none

	column 'DistanceM'
		dataType: double
		sourceColumn: DistanceM
		summarizeBy: none

	column 'TimeMs'
		dataType: double
		sourceColumn: TimeMs
		summarizeBy: none

	column 'SpeedKmh'
		dataType: double
		sourceColumn: SpeedKmh
		summarizeBy: none

	column 'ThrottlePct'
		dataType: double
		sourceColumn: ThrottlePct
		summarizeBy: none

	column 'Brake'
		dataType: int64
		sourceColumn: Brake
		summarizeBy: none

	column 'Gear'
		dataType: int64
		sourceColumn: Gear
		summarizeBy: none

	column 'RPM'
		dataType: int64
		sourceColumn: RPM
		summarizeBy: none

	column 'X'
		dataType: double
		sourceColumn: X
		summarizeBy: none

	column 'Y'
		dataType: double
		sourceColumn: Y
		summarizeBy: none

	column 'Sector'
		dataType: int64
		sourceColumn: Sector
		summarizeBy: none

	column 'SVGX'
		dataType: double
		sourceColumn: SVGX
		summarizeBy: none

	column 'SVGY'
		dataType: double
		sourceColumn: SVGY
		summarizeBy: none

	column 'SpeedBand'
		dataType: string
		sourceColumn: SpeedBand
		summarizeBy: none

	partition 'FactTelemetry' = m
		mode: import
		source =
			let
				Source = Csv.Document(Binary.FromText("", BinaryEncoding.Base64), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				Typed = Table.TransformColumnTypes(Headers, {{"LapId", Int64.Type}, {"Bin", Int64.Type}, {"DistanceM", type number}, {"TimeMs", type number}, {"SpeedKmh", type number}, {"ThrottlePct", type number}, {"Brake", Int64.Type}, {"Gear", Int64.Type}, {"RPM", Int64.Type}, {"X", type number}, {"Y", type number}, {"Sector", Int64.Type}, {"SVGX", type number}, {"SVGY", type number}, {"SpeedBand", type text}}, "en-US")
			in
				Typed
