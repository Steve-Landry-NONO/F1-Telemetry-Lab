table 'ReplayTime'

	column 'Seconds'
		dataType: double
		sourceColumn: Seconds
		summarizeBy: none

	partition 'ReplayTime' = m
		mode: import
		source =
			let
				Source = Csv.Document(Binary.FromText("", BinaryEncoding.Base64), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				Typed = Table.TransformColumnTypes(Headers, {{"Seconds", type number}}, "en-US")
			in
				Typed
