table 'DimDistance'

	column 'Bin'
		dataType: int64
		sourceColumn: Bin
		summarizeBy: none

	column 'ProgressPct'
		dataType: double
		sourceColumn: ProgressPct
		summarizeBy: none

	partition 'DimDistance' = m
		mode: import
		source =
			let
				Source = Csv.Document(Binary.FromText("", BinaryEncoding.Base64), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				Typed = Table.TransformColumnTypes(Headers, {{"Bin", Int64.Type}, {"ProgressPct", type number}}, "en-US")
			in
				Typed
